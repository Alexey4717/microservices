{
  "name": "microservices",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "turbo run build:services build --filter=web-client --filter=telegram-mini-app --filter=//",
    "build:services": "pnpm --workspace-concurrency=1 --filter \"@apps/*\" run build",
    "build:services:prod": "pnpm --workspace-concurrency=1 --filter \"@apps/*\" run build:prod",
    "build:gateway": "pnpm --filter @apps/gateway run build",
    "build:users": "pnpm --filter @apps/users run build",
    "build:mailer": "pnpm --filter @apps/mailer run build",
    "build:files": "pnpm --filter @apps/files run build",
    "build:payments": "pnpm --filter @apps/payments run build",
    "build:telegram": "pnpm --filter @apps/telegram run build",
    "build:ai-assistant": "pnpm --filter @apps/ai-assistant run build",
    "build:gateway:prod": "pnpm --filter @apps/gateway run build:prod",
    "build:users:prod": "pnpm --filter @apps/users run build:prod",
    "build:mailer:prod": "pnpm --filter @apps/mailer run build:prod",
    "build:files:prod": "pnpm --filter @apps/files run build:prod",
    "build:payments:prod": "pnpm --filter @apps/payments run build:prod",
    "build:telegram:prod": "pnpm --filter @apps/telegram run build:prod",
    "build:ai-assistant:prod": "pnpm --filter @apps/ai-assistant run build:prod",
    "build:web": "pnpm --filter web-client build",
    "build:telegram-mini": "pnpm --filter telegram-mini-app build",
    "codegen": "pnpm --filter @libs/graphql run codegen",
    "copy:proto": "node scripts/copy-proto.mjs",
    "deploy": "nest deploy",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start gateway",
    "start:dev": "nest start gateway --watch",
    "start:gateway": "pnpm --filter @apps/gateway run dev",
    "start:users": "pnpm --filter @apps/users run dev",
    "start:mailer": "pnpm --filter @apps/mailer run dev",
    "start:files": "pnpm --filter @apps/files run dev",
    "start:payments": "pnpm --filter @apps/payments run dev",
    "start:telegram": "pnpm --filter @apps/telegram run dev",
    "start:ai-assistant": "pnpm --filter @apps/ai-assistant run dev",
    "start:web": "pnpm --filter web-client dev",
    "start:telegram-mini": "pnpm --filter telegram-mini-app dev",
    "start:web:prod": "pnpm --filter web-client start",
    "start:debug": "nest start gateway --debug --watch",
    "start:prod": "node dist/apps/gateway/src/main.js",
    "start:gateway:prod": "pnpm --filter @apps/gateway run start:prod",
    "start:users:prod": "pnpm --filter @apps/users run start:prod",
    "start:mailer:prod": "pnpm --filter @apps/mailer run start:prod",
    "start:files:prod": "pnpm --filter @apps/files run start:prod",
    "start:payments:prod": "pnpm --filter @apps/payments run start:prod",
    "start:telegram:prod": "pnpm --filter @apps/telegram run start:prod",
    "start:ai-assistant:prod": "pnpm --filter @apps/ai-assistant run start:prod",
    "start:all": "concurrently --names users,mailer,files,payments,telegram,ai-assistant,gateway --prefix-colors blue,magenta,green,yellow,red,white,cyan --kill-others-on-fail=false \"pnpm run start:users\" \"pnpm run start:mailer\" \"pnpm run start:files\" \"pnpm run start:payments\" \"pnpm run start:telegram\" \"pnpm run start:ai-assistant\" \"pnpm run start:gateway\"",
    "start:all:dev": "pnpm run start:all",
    "start:all:prod": "pnpm run build:services:prod && concurrently --names users,mailer,files,payments,telegram,ai-assistant,gateway --prefix-colors blue,magenta,green,yellow,red,white,cyan --kill-others-on-fail=false \"pnpm run start:users:prod\" \"pnpm run start:mailer:prod\" \"pnpm run start:files:prod\" \"pnpm run start:payments:prod\" \"pnpm run start:telegram:prod\" \"pnpm run start:ai-assistant:prod\" \"pnpm run start:gateway:prod\"",
    "prisma:generate": "prisma generate && prisma generate --config apps/gateway/prisma.config.ts && prisma generate --config apps/files/prisma.config.ts && prisma generate --config apps/payments/prisma.config.ts && prisma generate --config apps/ai-assistant/prisma.config.ts",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:gateway": "prisma migrate dev --config apps/gateway/prisma.config.ts",
    "prisma:migrate:files": "prisma migrate dev --config apps/files/prisma.config.ts",
    "prisma:migrate:payments": "prisma migrate dev --config apps/payments/prisma.config.ts",
    "prisma:migrate:ai-assistant": "prisma migrate dev --config apps/ai-assistant/prisma.config.ts",
    "lint": "eslint \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint:fix": "eslint \"apps/**/*.ts\" \"libs/**/*.ts\" --fix",
    "lint:web": "pnpm --filter web-client lint",
    "lint:telegram-mini": "pnpm --filter telegram-mini-app lint",
    "format:web": "pnpm --filter web-client format",
    "format:telegram-mini": "pnpm --filter telegram-mini-app format",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "ngrok:dev": "node scripts/ngrok-dev.mjs"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-s3": "^3.1131.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@libs/common": "workspace:*",
    "@libs/proto": "workspace:*",
    "@nestjs/apollo": "^14.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/graphql": "^14.0.0",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/microservices": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/client-runtime-utils": "^7.10.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.6.1",
    "grammy": "^1.46.0",
    "graphql": "^16.14.2",
    "graphql-sse": "^2.6.1",
    "graphql-subscriptions": "^3.0.0",
    "graphql-upload-ts": "^2.2.0",
    "nodemailer": "^10.0.1",
    "openai": "^7.27.0",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@rspack/core": "^2.0.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "^9.2.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "ngrok": "5.0.0-beta.2",
    "prettier": "^3.4.2",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "turbo": "^2.11.7",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2",
    "webpack-node-externals": "^3.0.0"
  }
}