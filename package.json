{
  "name": "microservices",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "nest build",
    "build:gateway": "nest build gateway && pnpm run copy:proto",
    "build:users": "nest build users && pnpm run copy:proto",
    "build:mailer": "nest build mailer",
    "build:files": "nest build files && pnpm run copy:proto",
    "build:payments": "nest build payments && pnpm run copy:proto",
    "build:gateway:prod": "node scripts/clean-dist.mjs gateway && nest build gateway -p apps/gateway/tsconfig.app.prod.json && pnpm run copy:proto",
    "build:users:prod": "node scripts/clean-dist.mjs users && nest build users -p apps/users/tsconfig.app.prod.json && pnpm run copy:proto",
    "build:mailer:prod": "node scripts/clean-dist.mjs mailer && nest build mailer -p apps/mailer/tsconfig.app.prod.json",
    "build:files:prod": "node scripts/clean-dist.mjs files && nest build files -p apps/files/tsconfig.app.prod.json && pnpm run copy:proto",
    "build:payments:prod": "node scripts/clean-dist.mjs payments && nest build payments -p apps/payments/tsconfig.app.prod.json && pnpm run copy:proto",
    "build:web": "pnpm --filter web-client build",
    "copy:proto": "node scripts/copy-proto.mjs",
    "deploy": "nest deploy",
    "format": "prettier --write \"apps/gateway/**/*.ts\" \"apps/users/**/*.ts\" \"apps/mailer/**/*.ts\" \"apps/files/**/*.ts\" \"apps/payments/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start gateway",
    "start:dev": "nest start gateway --watch",
    "start:gateway": "nest start gateway --watch",
    "start:users": "nest start users --watch",
    "start:mailer": "nest start mailer --watch",
    "start:files": "nest start files --watch",
    "start:payments": "nest start payments --watch",
    "start:web": "pnpm --filter web-client dev",
    "start:web:prod": "pnpm --filter web-client start",
    "start:debug": "nest start gateway --debug --watch",
    "start:prod": "node dist/apps/gateway/src/main.js",
    "start:gateway:prod": "node dist/apps/gateway/src/main.js",
    "start:users:prod": "node dist/apps/users/src/main.js",
    "start:mailer:prod": "node dist/apps/mailer/src/main.js",
    "start:files:prod": "node dist/apps/files/src/main.js",
    "start:payments:prod": "node dist/apps/payments/src/main.js",
    "start:all": "concurrently --names users,mailer,files,payments,gateway --prefix-colors blue,magenta,green,yellow,cyan --kill-others-on-fail=false \"pnpm run start:users\" \"pnpm run start:mailer\" \"pnpm run start:files\" \"pnpm run start:payments\" \"pnpm run start:gateway\"",
    "start:all:dev": "pnpm run start:all",
    "start:all:prod": "pnpm run build:users:prod && pnpm run build:mailer:prod && pnpm run build:files:prod && pnpm run build:payments:prod && pnpm run build:gateway:prod && concurrently --names users,mailer,files,payments,gateway --prefix-colors blue,magenta,green,yellow,cyan --kill-others-on-fail=false \"pnpm run start:users:prod\" \"pnpm run start:mailer:prod\" \"pnpm run start:files:prod\" \"pnpm run start:payments:prod\" \"pnpm run start:gateway:prod\"",
    "prisma:generate": "prisma generate && prisma generate --config apps/gateway/prisma.config.ts && prisma generate --config apps/files/prisma.config.ts && prisma generate --config apps/payments/prisma.config.ts",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:gateway": "prisma migrate dev --config apps/gateway/prisma.config.ts",
    "prisma:migrate:files": "prisma migrate dev --config apps/files/prisma.config.ts",
    "prisma:migrate:payments": "prisma migrate dev --config apps/payments/prisma.config.ts",
    "lint": "eslint \"apps/gateway/**/*.ts\" \"apps/users/**/*.ts\" \"apps/mailer/**/*.ts\" \"apps/files/**/*.ts\" \"apps/payments/**/*.ts\" \"libs/**/*.ts\"",
    "lint:fix": "eslint \"apps/gateway/**/*.ts\" \"apps/users/**/*.ts\" \"apps/mailer/**/*.ts\" \"apps/files/**/*.ts\" \"apps/payments/**/*.ts\" \"libs/**/*.ts\" --fix",
    "lint:web": "pnpm --filter web-client lint",
    "format:web": "pnpm --filter web-client format",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-s3": "^3.1131.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@libs/common": "workspace:*",
    "@libs/proto": "workspace:*",
    "@nestjs/apollo": "^14.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/graphql": "^14.0.0",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/microservices": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.6.1",
    "graphql": "^16.14.2",
    "graphql-upload-ts": "^2.2.0",
    "nodemailer": "^10.0.1",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@rspack/core": "^2.0.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "^9.2.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.4.2",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2",
    "webpack-node-externals": "^3.0.0"
  }
}