{
  "compilerOptions": {
    "baseUrl": "./",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "ignoreDeprecations": "6.0",
    "types": [
      "vitest/globals",
      "node"
    ],
    "paths": {
      "@libs/common": ["libs/common/src/index.ts"],
      "@libs/common/*": ["libs/common/src/*"],
      "@libs/proto": ["libs/proto/src/index.ts"],
      "@libs/proto/*": ["libs/proto/src/*"]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./apps/gateway/tsconfig.app.json"
    },
    {
      "path": "./apps/users/tsconfig.app.json"
    },
    {
      "path": "./apps/mailer/tsconfig.app.json"
    },
    {
      "path": "./apps/files/tsconfig.app.json"
    },
    {
      "path": "./libs/common/tsconfig.lib.json"
    },
    {
      "path": "./libs/proto/tsconfig.lib.json"
    }
  ]
}
