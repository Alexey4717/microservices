generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/files-client"
}

datasource db {
  provider = "postgresql"
}

model File {
  id           String   @id @default(uuid())
  ownerUserId  String
  bucket       String
  objectKey    String   @unique
  originalName String
  mimeType     String
  size         Int
  url          String
  createdAt    DateTime @default(now())

  @@index([ownerUserId])
}

enum VideoStatus {
  PENDING
  READY
}

model Video {
  id          String      @id @default(uuid())
  ownerUserId String
  title       String
  description String
  bucket      String
  objectKey   String      @unique
  mimeType    String
  size        Int
  url         String
  status      VideoStatus
  createdAt   DateTime    @default(now())

  @@index([ownerUserId])
  @@index([status, createdAt])
}
