# Абсолютный URL GraphQL для упакованной сборки.
# electron-vite отдаёт в бандл только переменные с префиксом процесса.
# В dev (`pnpm run start:desktop`) остаётся относительный /graphql через прокси Vite.
RENDERER_VITE_GRAPHQL_URL=http://127.0.0.1:3000/graphql
MAIN_VITE_GRAPHQL_URL=http://127.0.0.1:3000/graphql
