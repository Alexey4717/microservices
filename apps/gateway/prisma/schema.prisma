generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/gateway-client"
}

datasource db {
  provider = "postgresql"
}

model UserProjection {
  id          String   @id
  email       String
  name        String?
  avatarUrl   String?
  accountTier String   @default("BASE")
  updatedAt   DateTime @updatedAt
}
