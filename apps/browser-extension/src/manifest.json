{
  "manifest_version": 3,
  "name": "Кабинет: учебное расширение",
  "version": "0.1.0",
  "description": "Подсказки на каталоге видео, заметки, напоминание и счётчик GraphQL для локального кабинета.",
  "key": "",
  "permissions": [
    "storage",
    "sidePanel",
    "contextMenus",
    "alarms",
    "notifications",
    "webRequest",
    "tabs"
  ],
  "host_permissions": ["http://localhost:4000/*", "http://localhost:3000/*"],
  "externally_connectable": {
    "matches": ["http://localhost:4000/*"]
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon-128.png",
    "default_title": "Кабинет"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "icons": {
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:4000/videos",
        "http://localhost:4000/videos/*"
      ],
      "js": ["content/catalog.js"],
      "css": ["content/catalog.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:4000/videos",
        "http://localhost:4000/videos/*"
      ],
      "js": ["content/catalog.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "commands": {
    "open-side-panel": {
      "suggested_key": {
        "default": "Alt+Shift+K",
        "mac": "Alt+Shift+K"
      },
      "description": "Открыть боковую панель"
    }
  }
}
