NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/users
GATEWAY_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/gateway

JWT_SECRET=change-me-jwt-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

USERS_GRPC_URL=127.0.0.1:50051
RABBITMQ_URL=amqp://guest:guest@localhost:5672
INTERNAL_SERVICE_TOKEN=change-me-internal-service-token

MAILER_HOST=127.0.0.1
MAILER_PORT=3001
NODEMAILER_USER_TRANSPORT=
NODEMAILER_PASSWORD_TRANSPORT=
NODEMAILER_FROM=

OAUTH_CALLBACK_BASE_URL=http://localhost:3000
OAUTH_SUCCESS_REDIRECT_URL=http://localhost:4000/auth/callback
# Origin web-client: gateway CORS and payments Stripe/PayPal return URLs.
# Payments rewrites both success and cancel to {CORS_ORIGIN}/payments/<paymentUuid>.
# Mini App origin добавляется в CORS gateway отдельно (TELEGRAM_MINI_APP_URL), CORS_ORIGIN не меняйте ради Mini App.
CORS_ORIGIN=http://localhost:4000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

FILES_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/files
FILES_GRPC_URL=127.0.0.1:50052
FILES_PORT=3002
FILES_HOST=127.0.0.1
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_BASE_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=avatars
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

PAYMENTS_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/payments
PAYMENTS_GRPC_URL=127.0.0.1:50053
PAYMENTS_PORT=3003
PAYMENTS_HOST=127.0.0.1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

TELEGRAM_BOT_TOKEN=
# Тот же токен читает users (HMAC Mini App loginWithTelegram) и сервис telegram.
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# pnpm run ngrok:dev -- 3004, оттуда скопировать URL + "/webhooks/telegram"
TELEGRAM_WEBHOOK_URL=
TELEGRAM_HOST=127.0.0.1
TELEGRAM_PORT=3004
# Публичный HTTPS Mini App (ngrok на :4001). Пусто — бот без webApp-клавиатуры.
# pnpm run start:telegram-mini && pnpm run ngrok:dev -- 4001
TELEGRAM_MINI_APP_URL=

# Как часто users удаляет истёкшие/использованные TelegramLinkToken (мс). 0 — выключить. По умолчанию 900000 (15 мин). При NODE_ENV=test задача не стартует.
TELEGRAM_LINK_TOKEN_CLEANUP_INTERVAL_MS=900000

# Dev: токен с https://dashboard.ngrok.com/get-started/your-authtoken (скрипт pnpm run ngrok:dev)
NGROK_AUTHTOKEN=